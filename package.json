{
  "name": "provider-data-factory",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prestart": "npm run build",
    "start": "node scripts/start-local.cjs",
    "dev": "tsc -w",
    "seed": "node dist/scripts/seed-raw.js",
    "test": "npm run build && node --test --test-concurrency=1 dist/test/*.test.js",
    "test:integration": "npm run build && node --test dist/test/integration/*.test.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0", "@nestjs/core": "^11.1.0", "@nestjs/platform-express": "^11.1.0",
    "bullmq": "^5.61.0", "ioredis": "^5.8.0", "mongodb": "^6.20.0",
    "reflect-metadata": "^0.2.2", "rxjs": "^7.8.2", "stream-json": "^1.9.1", "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0", "@types/stream-json": "^1.7.8", "typescript": "~5.9.3",
    "mongodb-memory-server": "^10.2.0"
  }
}
